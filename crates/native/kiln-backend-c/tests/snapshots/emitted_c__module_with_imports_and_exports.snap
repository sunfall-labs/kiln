            kiln_string_equals_ascii(data->properties[data->count - 1].key,
                                     "@@toStringTag", 13)) {
            insert_at = data->count - 1;
            memmove(&data->properties[insert_at + 1], &data->properties[insert_at],
                    (data->count - insert_at) * sizeof *data->properties);

int kiln_module_c045662854357f9876c16d9a1bf8a04d_namespace_wrapper(kiln_value *result, const char *const *names,
                               const size_t *name_lengths, const kiln_value *values,
                               size_t count) {
    kiln_value object;
    kiln_object *data = NULL;
    size_t *order = NULL;

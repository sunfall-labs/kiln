/target
*.profraw
/bench/results/*.json
!/bench/results/baseline.json
# Committed for the same reason baseline.json is: a recorded number is what makes a later
# change in it a diff someone has to justify. Written by scripts/server-baseline.sh.
!/bench/results/server-baseline.json
# Third-party bundle performance baseline (fastest-native Step 0.6)
!/bench/results/thirdparty-baseline.json
# Whole-program facts baseline for benchmarks and bundles (fastest-native Step 1.7)
!/bench/results/facts-baseline.json
# Native executable size baseline: a recorded number is what makes later growth
# a diff someone has to justify. Written by scripts/binary-sizes.sh.
!/bench/results/binary-sizes-baseline.json
.DS_Store
/.kiln/
**/.kiln/
node_modules/

# agent worktrees and session state
.claude/

# Large third-party probe bundles; the small ones are committed as fixtures.
/conformance/thirdparty/zod.bundle.js
/conformance/thirdparty/yaml.bundle.js
# The heavy set's three biggest: 9.9 MB of the TypeScript compiler, and two bundles that inline
# a whole toolchain. Same line as the two above -- reproducible from build.sh, too large to be a
# diff anyone reads.
/conformance/thirdparty/typescript.bundle.js
/conformance/thirdparty/react-ssr.bundle.js
/conformance/thirdparty/babel.bundle.js
/conformance/thirdparty/.scratch/

# insta writes a pending `.snap.new` beside a snapshot whenever one fails. It is a build artifact
# of the failing run, never a thing to commit -- `cargo insta accept` turns it into a real `.snap`
# -- and leaving it untracked is how `git add -A` sweeps one into somebody's commit.
*.snap.new

# Native test harness scratch: PID-named, written beside the fixture it compiles.
.kiln-native-*.mjs

# Ad-hoc differential probes written while chasing a bug. The filings under `.scratch/<feature>/`
# are deliberate and tracked; these are the scratch paper beside them.
.scratch/es/
# What `bench/io/fs-promises.mjs` writes and rewrites while it is being timed, and what
# `conformance/native/shape-keys-survive-collection.cjs` writes to make the collector run. Both
# have to live somewhere the program can reach, `.scratch` is otherwise tracked, and the adapter
# publishes no `unlink` -- so without these, running the benchmarks or the native corpus leaves
# stray files in everyone's `git status`.
.scratch/bench-io-test.tmp
.kiln-shape-keys-probe.tmp
gmon.out
__pycache__/

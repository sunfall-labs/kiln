#!/usr/bin/env bash
# Installed with `git config core.hooksPath .githooks` (`mise run hooks`). Cheap checks only: a
# commit must stay instant. The expensive loop is the pre-push hook.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
# Apple's /usr/bin/git is an xcrun shim that exports SDKROOT (the Xcode SDK) to everything it runs,
# hooks included; an interactive shell does not have it. With it set, native links in the checks
# below fail with "tapi error: malformed file ... unknown architecture" on Xcode 27's .tbd files,
# although the same checks pass from a shell (2026-10-02; docs/issues/toolchain-sdkroot). The
# hook runs what a developer would run by hand, so it drops what git added.
unset SDKROOT
exec scripts/check-issue-deletions.sh --staged
